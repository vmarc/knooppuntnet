{
  "name": "frontend",
  "version": "5.0.3",
  "scripts": {
    "serve": "ng serve --proxy-config src/proxy-dev.conf.mjs",
    "serve:vmarc": "ng serve --proxy-config src/proxy-vmarc.conf.mjs",
    "serve:dev:nl": "ng serve --configuration=nl --proxy-config src/proxy-dev.conf.mjs",
    "serve:dev:de": "ng serve --configuration=de --proxy-config src/proxy-dev.conf.mjs",
    "serve:dev:fr": "ng serve --configuration=fr --proxy-config src/proxy-dev.conf.mjs",
    "serve:translation:nl": "ng serve --configuration=nl --proxy-config src/proxy-translation.conf.mjs",
    "serve:translation:de": "ng serve --configuration=de --proxy-config src/proxy-translation.conf.mjs",
    "serve:translation:fr": "ng serve --configuration=fr --proxy-config src/proxy-translation.conf.mjs",
    "extract-i18n": "ng extract-i18n --output-path src/locale",
    "prettier-check": "prettier --check --config .prettierrc --ignore-path .prettierignore --log-level warn \"{**/*,*}.{js,ts}\"",
    "prettier-write": "prettier --write --config .prettierrc --ignore-path .prettierignore --log-level warn \"{**/*,*}.{js,ts}\"",
    "lint": "ng lint",
    "build": "ng build",
    "test": "ng test",
    "bundle-report": "ng build --configuration production --source-map && source-map-explorer dist/frontend/en/*.js",
    "build-prod": "rm -rf ./dist/*; ng run frontend:build:production --progress --source-map --output-path ./dist/${npm_package_name}-${npm_package_version}",
    "sentry:release": "sentry-cli releases --org knooppuntnet --project knooppuntnet new \"${npm_package_version}\"",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org knooppuntnet --project knooppuntnet ./dist/${npm_package_name}-${npm_package_version}/browser && sentry-cli sourcemaps upload --org knooppuntnet --project knooppuntnet  --release ${npm_package_version} ./dist/${npm_package_name}-${npm_package_version}/browser",
    "zip": "cd dist; tar -czf ../../dist/${npm_package_name}-${npm_package_version}.tar.gz .",
    "dist": "run-s build-prod sentry:release sentry:sourcemaps zip"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.12",
    "@angular/cdk": "18.2.13",
    "@angular/common": "^18.2.12",
    "@angular/compiler": "^18.2.12",
    "@angular/core": "^18.2.12",
    "@angular/forms": "^18.2.12",
    "@angular/localize": "18.2.12",
    "@angular/material": "18.2.13",
    "@angular/platform-browser": "^18.2.12",
    "@angular/platform-browser-dynamic": "^18.2.12",
    "@angular/router": "^18.2.12",
    "@sentry/angular": "8.38.0",
    "@sentry/cli": "^2.38.2",
    "@swimlane/ngx-charts": "^20.5.0",
    "@types/file-saver": "^2.0.7",
    "angular-split": "^18.0.0",
    "canvg": "^4.0.2",
    "file-saver-es": "^2.0.5",
    "immutable": "^5.0.2",
    "jspdf": "^2.5.2",
    "marked": "^12.0.2",
    "ngx-clipboard": "^16.0.0",
    "ngx-cookie-service": "^18.0.0",
    "ngx-device-detector": "^8.0.0",
    "ngx-markdown": "18.1.0",
    "ngxtension": "^4.1.0",
    "ol": "9.1.0",
    "ol-geocoder": "4.3.3",
    "ol-mapbox-style": "12.3.2",
    "rxjs": "~7.8.1",
    "source-map-explorer": "^2.5.3",
    "tslib": "^2.6.3",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.12",
    "@angular-devkit/core": "18.2.12",
    "@angular-devkit/schematics": "18.2.12",
    "@angular-eslint/builder": "18.4.0",
    "@angular-eslint/eslint-plugin": "18.4.0",
    "@angular-eslint/eslint-plugin-template": "18.4.0",
    "@angular-eslint/schematics": "18.4.0",
    "@angular-eslint/template-parser": "18.4.0",
    "@angular/cli": "^18.2.12",
    "@angular/compiler-cli": "^18.2.12",
    "@angular/language-service": "18.2.12",
    "@schematics/angular": "18.0.3",
    "@softarc/eslint-plugin-sheriff": "^0.18.0",
    "@softarc/sheriff-core": "^0.18.0",
    "@types/jasmine": "~5.1.4",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "prettier-eslint": "^16.3.0",
    "ts-node": "~10.9.2",
    "typescript": "5.4.5"
  }
}
